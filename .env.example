# Port, auf dem der Server lauscht.
PORT=3000

# TMDB API Key (https://www.themoviedb.org/settings/api).
# Leer lassen: die App nutzt dann automatisch die mitgelieferten
# Fallback-Filme und funktioniert vollständig ohne Internetzugang.
TMDB_API_KEY=

# --- Nur für Docker Compose -----------------------------------------------
# Docker-Hub-Benutzername, unter dem das Image veröffentlicht wird.
# Wird ausschließlich für den Image-Namen in docker-compose.yml gebraucht,
# nicht von der Anwendung selbst. Leer lassen, wenn ihr lokal baut.
DOCKERHUB_USERNAME=

# --- Optional -------------------------------------------------------------
# Sprache der TMDB-Antworten.
# TMDB_LANGUAGE=de-DE

# Anzahl Filme pro Runde (5-100).
# MOVIES_PER_ROUND=40

# Maximale Teilnehmerzahl pro Raum (2-32).
# MAX_USERS_PER_ROOM=8

# Auf 1 setzen, wenn die App hinter einem Reverse Proxy läuft
# (damit Rate-Limiting die echte Client-IP sieht).
# TRUST_PROXY=0

# Erlaubte fremde Origins (kommagetrennt). Leer lassen, wenn Frontend und
# Backend - wie im Standardfall - unter derselben Domain laufen.
# CORS_ORIGIN=
